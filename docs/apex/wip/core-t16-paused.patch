+  'SSV Kilimanjaro': canon('Kilimanjaro-class dreadnought named in ME3 (LORE_REFERENCE.md).'),
+  'SSV Orizaba': canon('Kilimanjaro-class dreadnought named in ME3 (LORE_REFERENCE.md).'),
