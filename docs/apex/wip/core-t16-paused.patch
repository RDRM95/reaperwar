+  { id: 'fighters_drones', at: 48.0, label: 'Fighter screen', event: { kind: 'launch_drones', fleets: blockade, burst: 6 } },
+  { id: 'free_play', at: FINAL_BATTLE_LOCK_UNTIL, label: 'Orders unlock', event: { kind: 'player_control', locked: false } },
