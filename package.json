{
  "name": "mass-effect-reaper-war-simulator",
  "version": "0.6.0",
  "private": true,
  "description": "Unofficial, non-commercial Mass Effect 3 fan project: a browser-based Reaper War naval warfare simulator with canon and alternate-timeline rule sets.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sim": "node --import tsx/esm scripts/headless-battle.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
